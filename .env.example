# ============================================================
# Browsing Agent Configuration
# ============================================================
# Template kanonik konfigurasi. config.py TIDAK menyimpan default:
# semua parameter operasional wajib ada di .env; yang hilang memfail-fast
# startup dengan pesan error. Salin file ini ke .env lalu sesuaikan nilainya.
# Nilai di bawah adalah dummy/referensi, bukan kredensial nyata.


# --- API access ---
# Generate unique values. UI_API_KEY dan UI_TO_API_KEY harus tercantum di API_ALLOWED_KEYS.
# UI_API_KEY       : dipakai browser untuk memanggil /ui-api/ (disuntik Nginx).
# UI_TO_API_KEY    : dipakai Nginx untuk memanggil API (boleh sama dengan UI_API_KEY).
API_ALLOWED_KEYS=replace-with-caller-key,replace-with-ui-key,replace-with-ui-to-api-key
UI_API_KEY=replace-with-ui-key
UI_TO_API_KEY=replace-with-ui-to-api-key


# --- ModelHub (Provider Utama) ---
# Isi MODELHUB_API_KEY untuk memakai ModelHub sebagai LLM utama.
MODELHUB_API_KEY=your-modelhub-api-key-here
MODELHUB_BASE_URL=https://modelhub.example/v1
MODELHUB_MODEL_NAME=your-model-name
# Header HTTP koneksi LLM; bukan USER_AGENT crawler.
MODELHUB_USER_AGENT=curl/8.0


# --- LLM (parameter inferensi) ---
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1500
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2


# --- Azure OpenAI (Fallback, opsional) ---
# Hanya dipakai jika MODELHUB_API_KEY tidak diisi.
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT_NAME=your-azure-deployment
# AZURE_OPENAI_PREVIEW_API_VERSION=2024-12-01-preview
# AZURE_OPENAI_API_KEY=your-azure-api-key


# --- MLflow GenAI Tracing ---
# Tracing LangChain dikirim ke server MLflow; experiment ID harus sudah ada.
MLFLOW_TRACING_ENABLED=true
# Trace root menyimpan pertanyaan dan jawaban akhir; atur akses/retensi MLflow dengan sesuai.
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_ID=1
# URI MLflow yang dapat dijangkau container (mis. host.docker.internal atau IP server MLflow).
MLFLOW_CONTAINER_TRACKING_URI=http://host.docker.internal:5000
# Timeout (detik) untuk REST call MLflow dan pre-flight TCP check saat startup.
MLFLOW_HTTP_TIMEOUT=5
MLFLOW_PREFLIGHT_TIMEOUT=2.0


# --- SearXNG ---
# Secret key session cookie SearXNG (wajib bila service searxng dijalankan via Compose).
SEARXNG_SECRET=replace-with-random-searxng-secret
# URL/email kontak admin; wajib agar engine wikipedia/wikidata/openstreetmap aktif.
SEARXNG_CONTACT_URL=mailto:admin@example.com


# --- Search Provider ---
# Provider utama: duckduckgo | searxng (self-hosted, tanpa API key).
# DuckDuckGo dari IP server sering kena CAPTCHA; SearXNG lebih stabil di server.
SEARCH_PROVIDER=searxng
# Base URL SearXNG (wajib jika SEARCH_PROVIDER=searxng).
SEARXNG_BASE_URL=http://searxng:8080
# Jika provider utama gagal, coba provider lain yang tersedia.
SEARCH_FALLBACK_ENABLED=true
# Filter konten SearXNG: 0=off, 1=moderate, 2=strict.
SEARXNG_SAFESEARCH=1


# --- Search Tuning ---
# Domain kredibel (dicocokkan sebagai substring URL) dan skor ranking-nya.
SEARCH_TRUSTED_DOMAINS=.edu,.gov,.ac.id,.go.id,.or.id,.wikipedia.org,.britannica.com,.stackoverflow.com
SEARCH_TRUSTED_SCORE=10
SEARCH_DEFAULT_SCORE=1
# Jumlah link teratas yang dicetak ke log pencarian.
SEARCH_LOG_TOP_RESULTS=3
# Urutan backend DuckDuckGo; "lite" dipetakan ke backend ddgs "duckduckgo".
DDG_RETRY_BACKENDS=lite,lite,auto
# Jeda dasar (detik) sebelum retry; attempt ke-N menunggu attempt * nilai ini.
DDG_RETRY_DELAY_SECONDS=1.0


# --- Tool Limits ---
MAX_TOOL_CALLS=5
MAX_URLS_PER_QUERY=3
MAX_SEARCH_RESULTS=5
# Pool kandidat per pencarian untuk evaluasi relevansi (sebelum seleksi sumber).
SEARCH_CANDIDATE_LIMIT=20


# --- Fetching ---
REQUEST_TIMEOUT=30
BROWSER_FALLBACK_ENABLED=true
FETCH_MAX_RETRIES=3
BROWSER_WAIT_TIMEOUT=10
FETCH_MAX_CONTENT_CHARS=3000
# Backoff eksponensial: base ** attempt (detik).
FETCH_BACKOFF_BASE_SECONDS=2.0
# HTML dengan teks lebih pendek dari ini dianggap JS-heavy dan memakai browser.
BROWSER_JS_HEAVY_MIN_CHARS=500
# Jumlah heading yang disertakan dalam konteks LLM.
FETCH_MAX_HEADINGS=5
# Path browser di image/container; kosongkan untuk mengunduh lewat webdriver-manager.
# CHROME_BIN=/usr/bin/chromium
# CHROMEDRIVER_PATH=/usr/bin/chromedriver


# --- Safe Crawling ---
USER_AGENT=BrowsingAgent/0.1
RATE_LIMIT_PER_DOMAIN_SECONDS=1.0
# true: robots.txt gagal di-fetch (non-404) => izinkan; false: tolak (fail-closed).
ROBOTS_FAIL_OPEN=true
# TTL cache robots.txt per domain (detik).
ROBOTS_CACHE_TTL_SECONDS=3600
# Domain sensitif dicocokkan per label (domain persis atau subdomain-nya).
GUARDRAIL_BLOCKED_DOMAINS=bca.co.id,bni.co.id,mandiri.co.id,bri.co.id
# Segmen path yang ditolak; nilai "login" menolak path yang mengandung "/login".
GUARDRAIL_BLOCKED_PATH_SEGMENTS=login,signin,auth,admin


# --- Content Extraction ---
CHUNK_SIZE=2000
# Jumlah karakter main_text untuk hash dedup dan snippet citation.
EVIDENCE_HASH_CHARS=500
EVIDENCE_SNIPPET_CHARS=300


# --- API Inbound Limits ---
# Rate limit per API key via Redis; (Compose mewajibkan isi).
# Redis down => API membalas 503 (fail-closed, ADR-0006).
RATE_LIMIT_REDIS_URL=redis://redis:6379/0
RATE_LIMIT_REQUESTS_PER_MINUTE=10
# Timeout socket Redis (detik) dan ukuran window fixed-window (detik).
RATE_LIMIT_REDIS_TIMEOUT=1.0
RATE_LIMIT_WINDOW_SECONDS=60
# Prefix bucket Redis, panjang hash identitas key, dan kelipatan TTL window.
RATE_LIMIT_BUCKET_PREFIX=ratelimit
RATE_LIMIT_KEY_HASH_CHARS=16
RATE_LIMIT_BUCKET_TTL_FACTOR=2
MAX_CONCURRENT_AGENT_RUNS=4
MAX_QUESTION_LENGTH=2000


# --- Deployment / Compose ---
# Port host untuk Nginx (UI + API ingress).
NGINX_PORT=8080


# --- Evaluasi offline DSPy (hanya runner, bukan startup produksi) ---
EVAL_TEMPERATURE=0
EVAL_LLM_MAX_RETRIES=0
EVAL_MAX_LM_CALLS=160
EVAL_GEPA_METRIC_CALLS=24
EVAL_SEED=17
