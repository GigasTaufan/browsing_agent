# ============================================================
# Browsing Agent Configuration
# ============================================================


# --- API access ---
# Generate unique values. UI_API_KEY must also appear in API_ALLOWED_KEYS.
API_ALLOWED_KEYS=replace-with-caller-key,replace-with-ui-key
UI_API_KEY=replace-with-ui-key

# --- Model Hub (Provider Utama) ---
# Isi MODELHUB_API_KEY untuk memakai ModelHub sebagai LLM utama.
MODELHUB_API_KEY=your-modelhub-api-key-here
MODELHUB_BASE_URL=https://api-modelhub.aiplayground.id/v1
MODELHUB_MODEL_NAME=gpt-4o-mini

# --- Azure OpenAI (Fallback, opsional) ---
# Hanya dipakai jika MODELHUB_API_KEY tidak diisi.
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
# AZURE_OPENAI_PREVIEW_API_VERSION=2024-12-01-preview
# AZURE_OPENAI_API_KEY=your-api-key-here

# --- MLflow GenAI Tracing ---
# Tracing LangChain (LLM, tools, agent graph) dikirim ke server MLflow.
MLFLOW_TRACING_ENABLED=true
MLFLOW_TRACKING_URI=http://10.60.144.48:5000
MLFLOW_EXPERIMENT_NAME=browsing-agent-dev

# --- Tool Limits ---
MAX_TOOL_CALLS=5
MAX_URLS_PER_QUERY=3
MAX_SEARCH_RESULTS=5

# --- Fetching ---
REQUEST_TIMEOUT=30
BROWSER_FALLBACK_ENABLED=true

USER_AGENT="BrowsingAgent/0.1"
RATE_LIMIT_PER_DOMAIN_SECONDS=1.0

# --- Content Extraction ---
CHUNK_SIZE=2000
