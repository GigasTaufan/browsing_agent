log_format safe_access '$remote_addr - $request_method $uri $status $body_bytes_sent rt=$request_time';
access_log /var/log/nginx/access.log safe_access;

server {
    listen 80;
    server_name _;

    # Docker embedded DNS: re-resolve upstream api setiap 10s agar
    # rebuild/restart container api tidak menyebabkan 502 stale IP.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_upstream http://api:8000;

    root /usr/share/nginx/html;
    index index.html;

    location = /healthz {
        access_log off;
        return 200 'ok';
        add_header Content-Type text/plain;
    }

    # Readiness: 200 hanya jika API hidup (health check port publish memakai ini).
    location = /healthz/ready {
        access_log off;
        proxy_pass $api_upstream/healthz;
        proxy_connect_timeout 2s;
        proxy_read_timeout 2s;
    }

    location /api/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }

    # Metrik operasional (ADR-0010); jaringan intranet.
    location = /api/metrics {
        access_log off;
        proxy_pass $api_upstream/metrics;
        proxy_set_header Host $host;
    }

    location /ui-api/ {
        rewrite ^/ui-api/(.*)$ /api/$1 break;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization "Bearer ${UI_TO_API_KEY}";
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
